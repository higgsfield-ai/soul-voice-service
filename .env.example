# AWS SQS, job media and model storage. Leave credentials blank when using an instance role/profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-north-1
SQS_REGION=eu-north-1
# Request queue: local-soul-voice. Payload result_queue_url: local-soul-voice-result.
SQS_QUEUE_URL=
SQS_VISIBILITY_TIMEOUT=300

# Used only by the model publisher/downloader. No fixed job-media bucket.
S3_MODEL_BUCKET=soul-voice-service
S3_MODEL_REGION=eu-north-1

# Parent directory of base/, raft/, round1/ and shared/.
VOICE_CHECKPOINT_DIR=checkpoints
BREEZE_SOURCE_DIR=third_party/breeze-tts
VOICE_DEVICE=cuda:0
# All original decoder modes: fused, cached, shipped.
VOICE_DEPTH=fused
VOICE_COMPILE=false
# Default when voice_config.max_new_tokens is omitted; a payload may override it.
VOICE_MAX_NEW_TOKENS=1024
WORK_DIR=/tmp/soul-voice
GPU_PROVIDER=nebius
INSTANCE_NAME=
