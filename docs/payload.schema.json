{
  "$defs": {
    "VoiceConfig": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "instruction": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "mode": {
          "default": "design",
          "enum": [
            "design",
            "clone",
            "direction"
          ],
          "title": "Mode",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "style_mix_alpha": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Style Mix Alpha",
          "type": "number"
        },
        "temperature": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_k": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K"
        },
        "depth_temperature": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Temperature"
        },
        "depth_top_k": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Top K"
        },
        "guidance_scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guidance Scale"
        },
        "max_new_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max New Tokens"
        }
      },
      "required": [
        "text",
        "instruction"
      ],
      "title": "VoiceConfig",
      "type": "object"
    }
  },
  "properties": {
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "s3_region": {
      "minLength": 1,
      "title": "S3 Region",
      "type": "string"
    },
    "sqs_region": {
      "minLength": 1,
      "title": "Sqs Region",
      "type": "string"
    },
    "result_queue_url": {
      "minLength": 1,
      "title": "Result Queue Url",
      "type": "string"
    },
    "task_type": {
      "const": "voice",
      "title": "Task Type",
      "type": "string"
    },
    "voice_config": {
      "$ref": "#/$defs/VoiceConfig"
    },
    "src_bucket_audio_pair": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Src Bucket Audio Pair"
    },
    "dst_bucket_audio_pair": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ],
      "title": "Dst Bucket Audio Pair",
      "type": "array"
    },
    "dst_bucket_metadata_pair": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dst Bucket Metadata Pair"
    }
  },
  "required": [
    "job_id",
    "s3_region",
    "sqs_region",
    "result_queue_url",
    "task_type",
    "voice_config",
    "dst_bucket_audio_pair"
  ],
  "title": "Payload",
  "type": "object"
}
